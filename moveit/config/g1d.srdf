<?xml version="1.0"?>
<!-- G1-D + Dex1 SRDF: two 7-DOF arm planning groups.
     Root chain AGV -> lift -> Pitching/Yaw -> torso is treated as
     the fixed "base frame" (their current joint values go into the
     start state; only the arm joints are planned). Dex1 fingers are
     NOT a MoveIt group - the bridge commands grippers directly. -->
<robot name="G1_D_Dex1">
  <group name="right_arm">
    <chain base_link="torso_link" tip_link="right_dex1_base_link"/>
  </group>
  <group name="left_arm">
    <chain base_link="torso_link" tip_link="left_dex1_base_link"/>
  </group>

  <group_state name="home" group="right_arm">
    <joint name="right_shoulder_pitch_joint" value="0.0"/>
    <joint name="right_shoulder_roll_joint" value="0.0"/>
    <joint name="right_shoulder_yaw_joint" value="0.0"/>
    <joint name="right_elbow_joint" value="0.3"/>
    <joint name="right_wrist_roll_joint" value="0.0"/>
    <joint name="right_wrist_pitch_joint" value="0.0"/>
    <joint name="right_wrist_yaw_joint" value="0.0"/>
  </group_state>
  <group_state name="home" group="left_arm">
    <joint name="left_shoulder_pitch_joint" value="0.0"/>
    <joint name="left_shoulder_roll_joint" value="0.0"/>
    <joint name="left_shoulder_yaw_joint" value="0.0"/>
    <joint name="left_elbow_joint" value="0.3"/>
    <joint name="left_wrist_roll_joint" value="0.0"/>
    <joint name="left_wrist_pitch_joint" value="0.0"/>
    <joint name="left_wrist_yaw_joint" value="0.0"/>
  </group_state>

  <!-- adjacent + near-adjacent pairs; the torso clears both arms -->
  <!-- WHOLE-BODY groups: every POSITION-servoed joint on the chain.
       right/left_whole: lift (LZ_mt/LZ_it) + waist yaw/pitch + arm
       (13 DOF redundant chain from the AGV base). Wheels are NOT on
       the chain; the lift executes via rt/cmd_hispeed velocity (the
       bridge converts position targets), waist via motors 12/13. -->
  <group name="waist">
    <joint name="torso_Joint"/>
    <joint name="Yaw_Joint"/>
  </group>
  <group name="right_gripper">
    <joint name="right_dex1_finger_joint_1"/>
    <joint name="right_dex1_finger_joint_2"/>
  </group>
  <group name="left_gripper">
    <joint name="left_dex1_finger_joint_1"/>
    <joint name="left_dex1_finger_joint_2"/>
  </group>
  <group name="right_whole">
    <chain base_link="AGV_link" tip_link="right_dex1_base_link"/>
  </group>
  <group name="left_whole">
    <chain base_link="AGV_link" tip_link="left_dex1_base_link"/>
  </group>
  <group_state name="tucked" group="right_whole">
    <joint name="LZ_mt_Joint" value="0.0"/>
    <joint name="LZ_it_Joint" value="0.0"/>
    <joint name="torso_Joint" value="0.0"/>
    <joint name="Yaw_Joint" value="0.0"/>
    <joint name="right_shoulder_pitch_joint" value="-0.6"/>
    <joint name="right_elbow_joint" value="1.2"/>
    <joint name="right_wrist_pitch_joint" value="-0.9"/>
  </group_state>

  <disable_collisions link1="torso_link" link2="right_shoulder_pitch_link"/>
  <disable_collisions link1="torso_link" link2="right_shoulder_roll_link"/>
  <disable_collisions link1="torso_link" link2="right_shoulder_yaw_link"/>
  <disable_collisions link1="torso_link" link2="right_elbow_link"/>
  <disable_collisions link1="torso_link" link2="right_wrist_roll_link"/>
  <disable_collisions link1="torso_link" link2="left_shoulder_pitch_link"/>
  <disable_collisions link1="torso_link" link2="left_shoulder_roll_link"/>
  <disable_collisions link1="torso_link" link2="left_shoulder_yaw_link"/>
  <disable_collisions link1="torso_link" link2="left_elbow_link"/>
  <disable_collisions link1="torso_link" link2="left_wrist_roll_link"/>
  <disable_collisions link1="right_shoulder_pitch_link" link2="right_shoulder_roll_link"/>
  <disable_collisions link1="right_shoulder_pitch_link" link2="right_shoulder_yaw_link"/>
  <disable_collisions link1="right_shoulder_roll_link" link2="right_shoulder_yaw_link"/>
  <disable_collisions link1="right_shoulder_roll_link" link2="right_elbow_link"/>
  <disable_collisions link1="right_shoulder_yaw_link" link2="right_elbow_link"/>
  <disable_collisions link1="right_shoulder_yaw_link" link2="right_wrist_roll_link"/>
  <disable_collisions link1="right_elbow_link" link2="right_wrist_roll_link"/>
  <disable_collisions link1="right_elbow_link" link2="right_wrist_pitch_link"/>
  <disable_collisions link1="right_wrist_roll_link" link2="right_wrist_pitch_link"/>
  <disable_collisions link1="right_wrist_pitch_link" link2="right_wrist_yaw_link"/>
  <disable_collisions link1="right_wrist_pitch_link" link2="right_dex1_base_link"/>
  <disable_collisions link1="right_wrist_yaw_link" link2="right_dex1_base_link"/>
  <disable_collisions link1="right_dex1_base_link" link2="right_dex1_finger_link_1"/>
  <disable_collisions link1="right_dex1_base_link" link2="right_dex1_finger_link_2"/>
  <disable_collisions link1="left_shoulder_pitch_link" link2="left_shoulder_roll_link"/>
  <disable_collisions link1="left_shoulder_pitch_link" link2="left_shoulder_yaw_link"/>
  <disable_collisions link1="left_shoulder_roll_link" link2="left_shoulder_yaw_link"/>
  <disable_collisions link1="left_shoulder_roll_link" link2="left_elbow_link"/>
  <disable_collisions link1="left_shoulder_yaw_link" link2="left_elbow_link"/>
  <disable_collisions link1="left_shoulder_yaw_link" link2="left_wrist_roll_link"/>
  <disable_collisions link1="left_elbow_link" link2="left_wrist_roll_link"/>
  <disable_collisions link1="left_elbow_link" link2="left_wrist_pitch_link"/>
  <disable_collisions link1="left_wrist_roll_link" link2="left_wrist_pitch_link"/>
  <disable_collisions link1="left_wrist_pitch_link" link2="left_wrist_yaw_link"/>
  <disable_collisions link1="left_wrist_pitch_link" link2="left_dex1_base_link"/>
  <disable_collisions link1="left_wrist_yaw_link" link2="left_dex1_base_link"/>
  <disable_collisions link1="left_dex1_base_link" link2="left_dex1_finger_link_1"/>
  <disable_collisions link1="left_dex1_base_link" link2="left_dex1_finger_link_2"/>
</robot>
